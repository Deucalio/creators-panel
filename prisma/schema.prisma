// ─────────────────────────────────────────────────────────────────────────────
// GENERATED COPY — DO NOT EDIT, AND DO NOT MIGRATE FROM HERE.
//
// Canonical schema: ../partner-loop-creator-growth/prisma/schema.prisma
//
// The Shopify admin app owns this database and is the only project that runs
// `prisma db push` / `prisma migrate`. This copy exists so `prisma generate`
// can produce a typed client for the same tables. After any schema change:
//
//   npm run schema:sync
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  shop                String   @id
  onboardingCompleted Boolean  @default(false)
  // Mirrored from the Shopify Admin API so the creators-panel can format money
  // without holding Admin API credentials of its own.
  currencyCode        String   @default("USD")
  /// The shop's customer-facing contact address, mirrored for the same reason.
  ///
  /// Shopify's `Shop.contactEmail` is already the address used for talking to
  /// customers, so it is appropriate to show a creator — unlike the account
  /// owner's email. It exists so the portal can stop telling people to contact
  /// the merchant without ever saying how.
  supportEmail        String?
  /// The shop's name as shoppers see it (`Shop.name`), mirrored the same way.
  /// Without it the portal could only name the store by its myshopify handle —
  /// "by quickstart-65d173cf" on the first page a creator ever sees.
  name                String?
  /// The storefront's primary domain host, e.g. "brand.com", mirrored the same
  /// way. Live stores sell on their own domain, so that is what a creator copies
  /// out of the address bar; without it the portal could only accept and build
  /// `*.myshopify.com` links. Null until the merchant's dashboard first loads.
  primaryDomain       String?
  /// Last known state of the storefront tracking embed: "active" | "inactive" |
  /// "unknown". Mirrored by the dashboard so the attention centre can flag a
  /// broken setup on every page without paying for a theme query each time.
  embedStatus         String?
  programs            Program[]
  businessInfo        BusinessInfo?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Program {
  id              String   @id @default(uuid())
  shopId          String
  name            String
  description     String?
  status          ProgramStatus @default(ACTIVE)
  isDefault       Boolean  @default(false)
  
  commissionConfig CommissionConfig?
  productRules     ProductCommissionRule[]
  customerRules    CustomerCommissionRule[]
  trackingConfig   TrackingConfig?
  creators         Creator[]
  clicks           Click[]

  store           Store    @relation(fields: [shopId], references: [shop], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
}

/// The program's default rule — the last step in the precedence chain.
model CommissionConfig {
  id        String   @id @default(uuid())
  programId String   @unique
  type      CommissionType
  amount    Float
  /// Orders whose qualifying subtotal falls below this earn nothing at all.
  /// Evaluated against the whole order before any rule is applied, so it is a
  /// gate rather than another rule. Null means no minimum.
  minimumOrderValue Float?
  /// Days to hold a commission before it should be approved, giving refunds and
  /// cancellations time to surface. Sets `Commission.eligibleAt` at creation.
  /// Recorded and shown, not enforced in V1.
  holdDays          Int?

  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
}

enum CommissionType {
  PERCENTAGE
  FIXED_PER_ORDER
  FIXED_PER_ITEM
}

/// A per-product override: "Product A earns 20%, everything else the default".
///
/// Only PERCENTAGE and FIXED_PER_ITEM are allowed here, enforced in the service
/// layer. Both decompose cleanly onto a single line item, whereas
/// FIXED_PER_ORDER is a whole-order amount — "pay £10 if Product A is present"
/// has no sensible answer when two such products are in the same order, so that
/// rule type stays program-level only.
model ProductCommissionRule {
  id           String   @id @default(uuid())
  programId    String
  /// Shopify product GID, e.g. gid://shopify/Product/123. Kept as the numeric id
  /// too, because webhook payloads are REST-shaped and carry `product_id`.
  productId    String
  /// Denormalised for the merchant UI so listing rules needs no Admin API call.
  productTitle String
  /// Storefront handle, so the creator portal can build a shareable product URL
  /// (`/products/<handle>?ref=CODE`) without Admin API credentials of its own.
  /// The resource picker already returns it; it simply was not stored before.
  /// Nullable because rules saved before Phase 13 have none — those degrade to
  /// a named product with no ready-made link until the program is saved again.
  productHandle String?
  type         CommissionType
  amount       Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  /// One rule per product per program; re-adding a product edits its rule.
  @@unique([programId, productId])
  @@index([programId])
}

/// Customer-facing discount on a creator's coupon. Deliberately not
/// `CommissionType`, whose FIXED_PER_ITEM has no meaning for a Shopify discount
/// code and whose values mean money owed rather than money off.
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CustomerType {
  NEW
  RETURNING
}

/// "New customers earn the creator 15%, returning ones 5%."
///
/// Sits between product overrides and the program default: it *replaces* the
/// default for lines that no product rule claimed, so it supports the same three
/// rule types the default does. Applied only when the customer's history is
/// actually known — a guest checkout falls through to the program default rather
/// than being guessed at.
model CustomerCommissionRule {
  id           String   @id @default(uuid())
  programId    String
  customerType CustomerType
  type         CommissionType
  amount       Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, customerType])
  @@index([programId])
}

model TrackingConfig {
  id                    String   @id @default(uuid())
  programId             String   @unique
  linkTrackingEnabled   Boolean  @default(true)
  couponTrackingEnabled Boolean  @default(false)
  /// What the *shopper* gets for entering a creator's code — nothing to do with
  /// what the creator earns, which is `CommissionConfig`. Without it a coupon
  /// gives a shopper no reason to type anything, and tracks nothing.
  ///
  /// Per program rather than per creator: one negotiated rate for everyone in a
  /// program is how these are normally run, and it keeps approval a one-click
  /// decision.
  couponDiscountType    DiscountType?
  couponDiscountValue   Float?

  program               Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model BusinessInfo {
  id                  String   @id @default(uuid())
  shopId              String   @unique
  industry            String
  businessDescription String?

  store               Store    @relation(fields: [shopId], references: [shop], onDelete: Cascade)
}

/// One human identity, independent of any program. Credentials live here so a
/// creator has a single login even when they promote several merchants — email
/// is unique globally, which is what makes sign-in unambiguous.
/// A single failed creator sign-in, kept only long enough to throttle guessing.
///
/// Database-backed rather than an in-memory counter on purpose: the creator
/// portal is a Next app that may run as several instances or as serverless
/// functions, where a per-process Map resets constantly and throttles nothing.
///
/// Rows are pruned on every check, so the table stays roughly
/// (attempts within the window) in size rather than growing forever.
model LoginAttempt {
  id        String   @id @default(uuid())
  /// Either `email:<address>` or `ip:<address>`. Two buckets: the email bucket
  /// stops one account being ground down, the IP bucket stops one attacker
  /// sweeping many accounts.
  scope     String
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
}

model CreatorAccount {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  firstName       String
  lastName        String
  /// How this creator wants to be paid: "Easypaisa", "JazzCash" or "Bank transfer",
  /// mirroring `Payout.method`. Merchants pay by hand, so both apps offer only that
  /// list (`app/payout-methods.js`, and `lib/payout-methods.ts` in the portal). A
  /// column of text, not an enum, because older accounts saved free text.
  payoutMethod    String?
  /// Whatever the method needs: a name and mobile wallet number, or an account
  /// title, bank and IBAN. Free text, because a wallet and a bank account don't
  /// share a shape.
  ///
  /// The creator owns this: they enter and change it in the portal, and the
  /// merchant only reads it when recording a payment. It is the first
  /// financial detail this app stores about anyone, so the privacy policy names
  /// it explicitly, and it is per-account rather than per-membership — a
  /// creator is paid the same way by every merchant they work with.
  payoutDetails   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Creator[]
}

/// A creator's membership of one program. One account can hold several, each
/// with its own referral code, approval status and earnings.
model Creator {
  id              String   @id @default(uuid())
  accountId       String
  programId       String
  // Public tracking slug used in share links (?ref=<code>) and as the creator's
  // coupon code. Per-membership, so earnings never cross between merchants.
  referralCode    String   @unique
  /// Shopify GID of the discount code created for this creator, when the
  /// program has coupon tracking on. Held so the code can be deactivated when
  /// the creator is, and reactivated if they come back — rather than orphaning
  /// a live discount in the merchant's store that nobody can trace.
  discountNodeId  String?
  status          CreatorStatus @default(PENDING)
  /// Why this membership is not active, shown to the creator in their portal.
  ///
  /// Deliberately not named `rejectionReason` like the one on `Commission`:
  /// this covers being paused as well as being turned down, and a creator
  /// reading "This membership is paused" deserves the same explanation as one
  /// reading "wasn't approved". Required when rejecting, optional when pausing —
  /// rejection is the decision someone cannot appeal without knowing the cause.
  ///
  /// Cleared on approval, so a reinstated creator is not left staring at the
  /// reason they were once turned down.
  statusReason    String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account         CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  referrals       Referral[]
  commissions     Commission[]
  payouts         Payout[]
  clicks          Click[]

  // An account joins any given program at most once.
  @@unique([accountId, programId])
}

/// A storefront visit carrying a creator's ?ref= code.
///
/// Recorded by the theme app embed through the App Proxy. `visitorId` is an
/// anonymous id minted in the browser — without it one shopper refreshing five
/// times would read as five clicks and wreck the conversion rate.
model Click {
  id           String   @id @default(uuid())
  creatorId    String
  programId    String
  visitorId    String
  landingPage  String
  referrer     String?
  createdAt    DateTime @default(now())

  creator      Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([creatorId, createdAt])
  @@index([programId, createdAt])
  @@index([visitorId, creatorId, createdAt])
}

enum CreatorStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

model Referral {
  id              String   @id @default(uuid())
  creatorId       String
  // Shopify order GID. Unique because webhooks are delivered at-least-once —
  // without this a redelivery would create a second referral and a second
  // commission for the same order, and the creator would be paid twice.
  // Nullable for referrals not sourced from an order; Postgres allows many NULLs
  // under a unique index.
  orderId         String?  @unique
  orderNumber     String?  // Shopify order number (e.g. #1042)
  orderAmount     Float
  status          ReferralStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  commission      Commission?
}

enum ReferralStatus {
  PENDING
  APPROVED
  REJECTED
}

/// What a creator is *owed* for a referral — deliberately separate from whether
/// the referral happened at all.
///
/// A rejected commission does not undo the `Referral`: "Sarah generated this
/// order" stays true even when "Sarah should be paid for it" becomes false, e.g.
/// after a refund or a self-referral. Collapsing the two would rewrite
/// attribution history and make a creator's past work disappear from reporting.
model Commission {
  id              String   @id @default(uuid())
  creatorId       String
  referralId      String   @unique
  payoutId        String?
  /// What the creator is currently owed — or, once PAID, what they were actually
  /// paid. Refunds move this while the commission is still unpaid; after payment
  /// it is frozen, because money that has left cannot be un-sent.
  amount          Float
  /// The entitlement at attribution time, never rewritten. `amount` plus the
  /// adjustment ledger has to reconcile back to this, which is what lets the app
  /// explain "Rs 78 originally, −Rs 26 refunded, Rs 52 now" instead of silently
  /// showing a different number than the merchant remembers approving.
  originalAmount  Float?
  status          CommissionStatus @default(PENDING)
  /// Required when rejecting; the merchant has to say why.
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  /// Earliest date this should be approved, so refunds have time to surface.
  /// Derived from the program's hold period when the commission is created.
  /// Surfaced in the UI but **not enforced** in V1 — the field exists so adding
  /// enforcement later is a check, not a migration.
  eligibleAt      DateTime?
  /// The pricing terms this commission was earned under, frozen at attribution:
  /// `{ customerType, config, productRules, customerRules }` (see
  /// `pricingTerms` in commission.server.js). A refund re-prices the order
  /// through these rather than the program's current rules, for the same reason
  /// `eligibleAt` is stamped rather than derived — changing a rate today must not
  /// retroactively move money promised under yesterday's. It also pins the
  /// customer type: Shopify only exposes a *lifetime* order count, so asked again
  /// at refund time a first-time buyer who has since reordered reads as returning.
  /// Null for commissions created before this existed; those fall back to the
  /// program's current rules.
  terms           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  referral        Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  payout          Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  adjustments     CommissionAdjustment[]
}

/// An append-only ledger of everything that changed a commission after it was
/// created — refunds, cancellations, manual corrections.
///
/// Deliberately append-only: the original figure stays intact and each change is
/// explainable, rather than the commission quietly showing a different number
/// than the merchant approved. Deltas are signed, so a refund is negative.
model CommissionAdjustment {
  id           String   @id @default(uuid())
  commissionId String
  /// Signed change to the entitlement. Negative for refunds and cancellations.
  amount       Float
  reason       String
  /// The Shopify event that caused it — a refund id, or the order id for a
  /// cancellation. Unique per commission so a redelivered webhook is a no-op
  /// rather than a second deduction.
  sourceId     String?
  createdAt    DateTime @default(now())

  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@unique([commissionId, sourceId])
  @@index([commissionId])
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

/// A manual payment to a creator covering a batch of approved commissions.
///
/// Exists to answer "did I actually pay Sarah for this?" six months later, so it
/// records how and when, not just how much.
model Payout {
  id              String   @id @default(uuid())
  /// Human-readable sequence for referring to a payout: PL-0001.
  number          Int      @unique @default(autoincrement())
  creatorId       String
  amount          Float
  status          PayoutStatus @default(PENDING)
  /// "Easypaisa", "JazzCash" or "Bank transfer" — see `app/payout-methods.js`. No payment provider in V1.
  method          String?
  /// The merchant's own transaction reference — the actual audit trail.
  reference       String?
  note            String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator         Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  commissions     Commission[]
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}
